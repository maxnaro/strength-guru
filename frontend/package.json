{
  "name": "strength-guru-web",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-web.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit --project src/service-worker/tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:perf": "node scripts/performance.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "5.58.1",
    "svelte-check": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  }
}
